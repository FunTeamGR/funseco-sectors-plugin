{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "funseco/sectors-plugin",
    "description": "Funseco sector records — /secrecs, /mysecrecs and the score-screen buttons",
    "license": "MIT",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^8.2",
        "funseco/core": "@dev"
    },
    "autoload": {
        "psr-4": {
            "Funseco\\Sectors\\": "src/"
        }
    },
    "require-dev": {
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^10.0",
        "phpunit/phpunit": "^11.5.3"
    },
    "autoload-dev": {
        "psr-4": {
            "Funseco\\Sectors\\Tests\\": "tests/"
        }
    },
    "extra": {
        "funseco": {
            "id": "sectors",
            "name": "Sector records",
            "description": "sector records — best time per sector of every map",
            "provider": "Funseco\\Sectors\\SectorsServiceProvider"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    }
}
